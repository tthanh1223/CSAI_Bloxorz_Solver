@startuml 4_solve_sequence
!include style.iuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
title Luồng bấm "Solve" rồi "Watch solution" (GUI)   ·   main @ 1d8eab4

actor "Người chơi" as User
participant "BloxorzApp\n(app.py)" as App
participant "ProcessSolverGateway\n(solver_gateway.py)" as GW
box "Process riêng (spawn)" #F3F6FA
participant "_solve()\nworker" as Worker
participant "AStar / BFS / DFS / UCS" as Solver
participant "BloxorzProblem" as Problem
end box
participant "PathReplay" as Replay
participant "RollAnimation" as Anim
participant "IsometricRenderer" as R

User -> App : chọn thuật toán, bấm **Solve**
App -> App : solve()\nrequest_id += 1
App -> GW : submit(SolverRequest(id, algorithm, stage, start, timeout=30))
GW -> Worker ** : Process(spawn) + Pipe
note right of App
  Giao diện không bị đơ:
  mỗi khung hình update() gọi gateway.poll()
  rồi vẽ lại "Finding a path..."
end note

Worker -> Solver : solve(BloxorzProblem(stage, start))
loop đến khi gặp goal
  Solver -> Problem : get_successors(state)
  Problem --> Solver : [(action, next_state, cost)]
end
Solver --> Worker : SolverResult (path, time, memory, nodes)
Worker --> GW : conn.send(SolverResponse(SOLVED, view))

loop mỗi khung hình (60 FPS)
  App -> GW : poll()
  alt đã có kết quả
    GW --> App : SolverResponse
  else quá 30 giây
    GW -> Worker !! : terminate()
    GW --> App : SolverResponse(TIMEOUT)
  else người chơi bấm Cancel
    App -> GW : cancel(id)
    GW -> Worker !! : terminate()
  end
end
App -> App : result = response.result\n(chỉ nhận nếu request_id khớp)
App --> User : "A way forward: N moves, t seconds"

User -> App : bấm **Watch solution**
App -> App : load_replay(start, path)\n(kiểm tra lại toàn bộ path)
App -> Replay : load(start, path); play()
loop từng bước
  App -> Replay : step()
  Replay --> App : action
  App -> App : apply_action(action, replay=True)
  App -> Anim : start(before, after, action)
  loop trong ~0.18 s
    App -> R : draw(surface, state, MotionFrame)
  end
end
App --> User : khối đứng trên goal (không tự chuyển màn khi đang replay)
@enduml
