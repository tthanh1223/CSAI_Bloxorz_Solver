@startuml 1_engine
!include style.iuml
title Bloxorz – Engine (src/engine)   ·   main @ 1d8eab4

package "state.py" {
  enum Orientation {
    STANDING
    LYING_H
    LYING_V
    SPLIT
  }
  enum Action {
    UP
    DOWN
    LEFT
    RIGHT
    SPACE
  }
  class GameState <<frozen dataclass>> {
    {field} + pos1 : Coord
    {field} + pos2 : Coord
    {field} + orientation : Orientation
    {field} + active_cube : int
    {field} + bridges_status : Tuple[bool, ...]
    .. ghi chú ..
    {field} Hashable -> dùng trong visited set
    {field} Khối đứng: pos1 == pos2
    {field} active_cube: chỉ dùng khi SPLIT
    {field} Khác bridges_status = state khác
  }
  class SearchNode <<frozen dataclass>> {
    {field} + state : GameState
    {field} + parent : SearchNode | None
    {field} + action : Action
    {field} + g : int
    {field} + h : float = 0
    + f() : float  <<property>>
    + __lt__(other) : bool
  }
}

package "loader.py" {
  enum TileType {
    FLOOR = '1'
    VOID = '0'
    START = 'S'
    GOAL = 'G'
    FRAGILE = 'F'
    BRIDGE = 'B'
  }
  class StageData {
    {field} + grid : List[List[TileType]]
    {field} + start : Coord
    {field} + goal : Coord
    {field} + switches : Dict[Coord, SwitchData]
    {field} + bridges : Dict[str, List[Coord]]
    {field} + initial_bridge_mask : Tuple[bool, ...]
  }
  class loader <<module>> {
    + load_stage(json_filepath) : StageData
  }
}

package "switches.py" {
  enum SwitchType {
    SOFT
    HEAVY
    SPLIT
  }
  class SwitchData <<frozen dataclass>> {
    {field} + type : SwitchType
    {field} + linked_bridges : Tuple[int, ...]
    {field} + is_toggle : bool
    {field} + bridge_actions : Tuple[Tuple[int, str], ...]
    {field} + target_pos1 : Coord | None
    {field} + target_pos2 : Coord | None
  }
  class switches <<module>> {
    + apply_tile_effects(blocks, is_split, bridges_status, stage_data)
  }
}

package "problem.py" {
  class BloxorzProblem {
    {field} + stage_data : StageData
    {field} + initial_state : GameState
    + is_goal(state) : bool
    + get_successors(state) : List[Tuple[Action, GameState, int]]
    + {static} roll_block(state, action) : GameState | None
    + fall_result(state, action) : GameState | None
    + check_validity(state) : bool
    - {static} _blocks_for_state(state) : Tuple[Coord, ...]
    - {static} _state_from_blocks(blocks, is_split, active_cube, mask) : GameState | None
    .. transition model ..
    {field} roll_block -> check_validity
    {field} -> apply_tile_effects -> check_validity
    {field} Mọi bước có cost = 1
    {field} fall_result(): chỉ GUI dùng (vẽ khối rơi)
  }
  class GameSession {
    {field} + problem : BloxorzProblem
    {field} + current_state : GameState
    {field} + history : List[GameState]
    {field} + moves : int
    {field} + status : "PLAYING" | "WON" | "LOST"
    + apply_action(action) : bool
    + fall(action) : GameState | None
    + undo()
    + restart()
  }
}

GameState --> Orientation
SearchNode --> GameState
SearchNode --> Action
SearchNode --> "0..1" SearchNode : parent
StageData --> TileType
StageData *-- "*" SwitchData
SwitchData --> SwitchType
loader ..> StageData : <<creates>>
switches ..> SwitchData
BloxorzProblem o-- StageData
BloxorzProblem --> GameState : initial_state
BloxorzProblem ..> switches : <<uses>>
GameSession o-- BloxorzProblem
GameSession --> GameState : current_state

@enduml
