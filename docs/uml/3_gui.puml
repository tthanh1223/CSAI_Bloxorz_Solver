@startuml 3_gui
!include style.iuml
title Bloxorz – GUI (src/gui, main_test.py)   ·   main @ 1d8eab4

class "main_test.py" as Main <<entry point>> {
  + main()
  + print_stage_map(stage)
  .. ..
  {field} --theme dream | blueprint | forest
  {field} --forest (OpenGL, thử nghiệm)
}

package "app.py" as P_app {
  class BloxorzApp {
    {field} + session : GameSession
    {field} + stage : StageData
    {field} + stage_paths / stage_index
    {field} + renderer : IsometricRenderer
    {field} + animation : RollAnimation
    {field} + replay : PathReplay
    {field} + gateway : SolverGateway
    {field} + sound : SoundBank | None
    {field} + actions : List[Action]
    {field} + algorithm : "BFS" | "IDS" | "UCS" | "ASTAR"
    {field} + result : SolverResultView | None
    {field} + win_phase : None | "roll" | "sink" | "choice"
    {field} + stage_cleared : bool
    {field} + zoom, pan, menu, message, ...
    .. chơi ..
    + apply_action(action, replay=False) : bool
    + undo() / restart() / select_stage(i)
    + start_fall(...) / finish_fall()
    + advance_win() / next_stage() / replay_win()
    .. solver & replay ..
    + solve(hint=False)
    + load_replay(start, path) / replay_step()
    + seek(i) / stop_replay()
    .. vòng lặp ..
    + update(dt) / draw()
    + handle_event(e) / handle_key(k) / command(key)
    + save(path) / load(path)
    + run()
  }
}

package "contracts.py" as P_contracts {
  interface SolverGateway <<Protocol>> {
    + submit(request)
    + poll() : SolverResponse | None
    + cancel(request_id)
    + close()
  }
  interface ReplayController <<Protocol>>
  interface BoardRenderer <<Protocol>>
  interface AnimationController <<Protocol>>
  class SolverRequest <<frozen>> {
    {field} request_id, algorithm, stage,
    {field} initial_state, timeout_sec = 30
  }
  class SolverResponse <<frozen>> {
    {field} request_id, status, result
  }
  class SolverResultView <<frozen>> {
    {field} algorithm, found, path, metrics, error
  }
  class SolverMetrics <<frozen>> {
    {field} time_sec, peak_memory_mb,
    {field} expanded_nodes, solution_length, total_cost
  }
  class MotionFrame <<frozen>> {
    {field} before, after, action, progress
    {field} falling : bool, sinking : bool
  }
  enum SolverStatus {
    IDLE
    RUNNING
    SOLVED
    NO_SOLUTION
    CANCELLED
    TIMEOUT
    ERROR
  }
  enum ReplayStatus {
    EMPTY
    READY
    PLAYING
    PAUSED
    FINISHED
  }
}

package "solver_gateway.py" as P_gw {
  class ProcessSolverGateway {
    {field} - process / connection / request
    + submit(request) / poll() / cancel(id) / close()
    .. ..
    {field} multiprocessing spawn + Pipe
    {field} timeout 30 s, hủy được
  }
  class "_solve(request, conn)" as Worker <<worker process>> {
    {field} 'IDS' -> DFS, 'ASTAR' -> AStar
    {field} không import pygame
  }
}

package "replay.py / animation.py" as P_motion {
  class PathReplay {
    {field} + initial_state, path, index
    {field} + status : ReplayStatus
    + load(start, path) / play() / pause()
    + step() : Action | None / reset()
  }
  class RollAnimation {
    {field} + duration_sec, busy
    {field} + frame : MotionFrame | None
    + start(before, after, action, falling, sinking)
    + update(dt) / reset()
  }
}

package "renderer3d.py" as P_render {
  class IsometricRenderer {
    {field} + view : "original" | "iso"
    {field} + camera : Camera3D
    {field} + zoom, pan, style
    {field} - material_cache, _static_key, _frame_key
    + set_stage(stage) / set_view(view) / resize(size)
    + draw(surface, state, motion)
    - _build_static(shown, broken)
    - _tip(pose, action) / _broken_tile(pose)
  }
  class Camera3D <<frozen>> {
    {field} + origin, tile_width, view, eye
    + project(row, col, height) : (x, y)
    + depth(row, col, z) : float
  }
  class geometry <<module>> {
    + cuboid() / bevel_mesh()
    + state_meshes() / rotate_mesh() / motion_meshes()
    + fall_meshes() / tip_mesh()
    + sink_meshes() / clip_below_floor()
    + perspective_eye() / perspective_raw()
  }
}

package "presentation.py / ui.py / theme*.py / dreamscape.py" as P_present {
  class presentation <<module>> {
    + draw(app) : bool
    {field} layout, panel solver, menu, hộp thoại "Stage complete"
  }
  class Button <<dataclass>> {
    {field} key, label, rect, enabled, selected, kind
    + draw(surface, font)
  }
  class themes <<module>> {
    + apply_theme(app, name) / cycle_theme(app)
  }
  class "theme / dreamscape" as look <<module>> {
    + font(level) / background(size, style, ...)
  }
}

package "sfx.py" as P_sfx {
  class SoundBank {
    {field} + sounds : Dict[str, Sound]
    {field} + from_file : Set[str]
    + play(name) / set_volume(v)
    .. ..
    {field} roll | switch | split | fall | win
    {field} file assets/sfx/<tên>.wav|ogg|mp3, thiếu thì dùng tiếng tạo bằng code
  }
}

package "forest.py (thử nghiệm)" as P_forest {
  class ForestRenderer <<OpenGL / moderngl>>
}

package "engine / solvers" as P_core {
  class GameSession
  class BloxorzProblem
  class "BFS / DFS / UCS / AStar" as Solvers
}

Main --> BloxorzApp : tạo và run()
Main ..> themes : apply_theme
Main ..> ForestRenderer : --forest

BloxorzApp *-- IsometricRenderer
BloxorzApp *-- RollAnimation
BloxorzApp *-- PathReplay
BloxorzApp o-- SolverGateway
BloxorzApp o-- SoundBank
BloxorzApp o-- GameSession
BloxorzApp ..> presentation : draw()
BloxorzApp ..> SolverRequest : gửi
BloxorzApp ..> SolverResponse : nhận (poll)

ProcessSolverGateway ..|> SolverGateway
PathReplay ..|> ReplayController
IsometricRenderer ..|> BoardRenderer
RollAnimation ..|> AnimationController
ForestRenderer ..|> BoardRenderer

ProcessSolverGateway ..> Worker : process riêng
Worker ..> Solvers : solve()
Worker ..> BloxorzProblem
SolverResponse --> SolverResultView
SolverResponse --> SolverStatus
SolverResultView --> SolverMetrics
PathReplay --> ReplayStatus
RollAnimation --> MotionFrame
IsometricRenderer *-- Camera3D
IsometricRenderer ..> geometry
IsometricRenderer ..> MotionFrame : đọc
presentation ..> Button
presentation ..> look
themes ..> IsometricRenderer : đổi màu, texture
GameSession o-- BloxorzProblem
@enduml
